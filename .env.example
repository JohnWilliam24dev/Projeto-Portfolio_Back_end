# URL exata do site publicado. Para mais de um domínio, separe por vírgulas.
ALLOWED_ORIGINS=https://seu-portfolio.vercel.app

# Obtidos no BotFather e na conversa com o bot. Nunca use prefixo VITE_.
TELEGRAM_BOT_TOKEN=123456789:substitua-por-um-token-real
TELEGRAM_CHAT_ID=123456789

# Postgres (Neon). DATABASE_URL: string pooled (host com -pooler), usada pela aplicação em
# runtime. DIRECT_URL: string direct (sem -pooler), usada só pelo CLI do Prisma (migrate,
# studio) — migrations precisam de advisory lock, que o pooler (PgBouncer) não sustenta.
DATABASE_URL=postgresql://usuario:senha@host-pooler/banco?sslmode=require
DIRECT_URL=postgresql://usuario:senha@host/banco?sslmode=require

# Cloudinary (Dashboard > API Keys > "API Environment variable"). Formato: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=cloudinary://123456789012345:substitua-o-secret@seu-cloud-name
