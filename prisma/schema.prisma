// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  // Obrigatório: Prisma 7 gera ESM por padrão, e este projeto compila pra CommonJS
  // (tsconfig "module": "commonjs", sem "type": "module" no package.json). Sem isso
  // o `require()` do client gerado quebra com ERR_REQUIRE_ESM em runtime.
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum StatusTipo {
  INICIAL
  EM_ANDAMENTO
  CONCLUIDO
  CANCELADO
}

model Maker {
  id               String    @id @default(uuid()) @db.Uuid
  nome             String
  termosCondicoes  String?   @map("termos_condicoes")
  facoENaoFaco     String?   @map("faco_e_nao_faco")
  apiKeySecretHash String?   @map("api_key_secret_hash")
  apiKeyGeradaEm   DateTime? @map("api_key_gerada_em")
  criadoEm         DateTime  @default(now()) @map("criado_em")

  statuses              Status[]
  tiposProduto          TipoProduto[]
  adicionais            Adicional[]
  tiposProdutoAdicional TipoProdutoAdicional[]
  produtos              Produto[]
  commissions           Commission[]
  commissionAdicionais  CommissionAdicional[]

  @@map("makers")
}

model Status {
  id       String     @id @default(uuid()) @db.Uuid
  makerId  String     @map("maker_id") @db.Uuid
  nome     String
  ordem    Int
  tipo     StatusTipo
  criadoEm DateTime   @default(now()) @map("criado_em")

  maker       Maker        @relation(fields: [makerId], references: [id])
  commissions Commission[]

  @@unique([id, makerId])
  @@index([makerId, ordem])
  @@map("status")
}

model TipoProduto {
  id         String   @id @default(uuid()) @db.Uuid
  makerId    String   @map("maker_id") @db.Uuid
  nome       String
  precoBase  Decimal  @map("preco_base") @db.Decimal(10, 2)
  habilitado Boolean  @default(true)
  criadoEm   DateTime @default(now()) @map("criado_em")

  maker       Maker                  @relation(fields: [makerId], references: [id])
  adicionais  TipoProdutoAdicional[]
  produtos    Produto[]
  commissions Commission[]

  @@unique([id, makerId])
  @@index([makerId])
  @@map("tipos_produto")
}

model Adicional {
  id          String   @id @default(uuid()) @db.Uuid
  makerId     String   @map("maker_id") @db.Uuid
  nome        String
  descricao   String?
  precoFixo   Decimal? @map("preco_fixo") @db.Decimal(10, 2)
  porcentagem Decimal? @db.Decimal(5, 2)
  habilitado  Boolean  @default(true)
  criadoEm    DateTime @default(now()) @map("criado_em")

  maker                Maker                  @relation(fields: [makerId], references: [id])
  tiposProduto         TipoProdutoAdicional[]
  commissionAdicionais CommissionAdicional[]

  @@unique([id, makerId])
  @@index([makerId])
  @@map("adicionais")
}

model TipoProdutoAdicional {
  tipoProdutoId String @map("tipo_produto_id") @db.Uuid
  adicionalId   String @map("adicional_id") @db.Uuid
  makerId       String @map("maker_id") @db.Uuid

  maker       Maker       @relation(fields: [makerId], references: [id])
  tipoProduto TipoProduto @relation(fields: [tipoProdutoId, makerId], references: [id, makerId], onDelete: Cascade)
  adicional   Adicional   @relation(fields: [adicionalId, makerId], references: [id, makerId], onDelete: Cascade)

  @@id([tipoProdutoId, adicionalId])
  @@index([adicionalId])
  @@index([makerId])
  @@map("tipos_produto_adicionais")
}

model Produto {
  id             String   @id @default(uuid()) @db.Uuid
  makerId        String   @map("maker_id") @db.Uuid
  tipoProdutoId  String   @map("tipo_produto_id") @db.Uuid
  nome           String
  descricao      String?
  imagemUrl      String   @map("imagem_url")
  imagemPublicId String   @map("imagem_public_id")
  criadoEm       DateTime @default(now()) @map("criado_em")

  maker       Maker       @relation(fields: [makerId], references: [id])
  tipoProduto TipoProduto @relation(fields: [tipoProdutoId, makerId], references: [id, makerId])

  @@index([makerId, criadoEm])
  @@index([tipoProdutoId])
  @@map("produtos")
}

model Commission {
  id                String   @id @default(uuid()) @db.Uuid
  makerId           String   @map("maker_id") @db.Uuid
  tipoProdutoId     String   @map("tipo_produto_id") @db.Uuid
  statusId          String   @map("status_id") @db.Uuid
  token             String   @unique @db.VarChar(5)
  nomeCliente       String   @map("nome_cliente")
  contato           String
  email             String?
  descricao         String
  imagemRefUrl      String   @map("imagem_ref_url")
  imagemRefPublicId String   @map("imagem_ref_public_id")
  precoSimulado     Decimal  @map("preco_simulado") @db.Decimal(10, 2)
  orcamentoFinal    Decimal? @map("orcamento_final") @db.Decimal(10, 2)
  posicao           Int      @default(0)
  criadoEm          DateTime @default(now()) @map("criado_em")

  maker       Maker                 @relation(fields: [makerId], references: [id])
  tipoProduto TipoProduto           @relation(fields: [tipoProdutoId, makerId], references: [id, makerId])
  status      Status                @relation(fields: [statusId, makerId], references: [id, makerId])
  adicionais  CommissionAdicional[]

  @@unique([id, makerId])
  @@index([makerId, statusId, posicao])
  @@index([tipoProdutoId])
  @@map("commissions_v2")
}

model CommissionAdicional {
  id               String  @id @default(uuid()) @db.Uuid
  makerId          String  @map("maker_id") @db.Uuid
  commissionId     String  @map("commission_id") @db.Uuid
  adicionalId      String  @map("adicional_id") @db.Uuid
  quantidade       Int
  descricaoCliente String  @map("descricao_cliente")
  valorUnitario    Decimal @map("valor_unitario") @db.Decimal(10, 2)

  maker      Maker      @relation(fields: [makerId], references: [id])
  commission Commission @relation(fields: [commissionId, makerId], references: [id, makerId], onDelete: Cascade)
  adicional  Adicional  @relation(fields: [adicionalId, makerId], references: [id, makerId])

  @@unique([commissionId, adicionalId])
  @@index([adicionalId])
  @@index([makerId])
  @@map("commission_adicionais")
}

model CommissionLegado {
  id                     String   @id @db.Uuid
  nickname               String
  contact                String
  modelType              String   @map("model_type")
  additionalContentNotes String   @default("") @map("additional_content_notes")
  acessorios             Int
  expressoesExtras       Int      @map("expressoes_extras")
  imagemUrl              String   @map("imagem_url")
  imagemPublicId         String   @map("imagem_public_id")
  criadoEm               DateTime @default(now()) @map("criado_em")

  @@map("commissions_legado")
}
